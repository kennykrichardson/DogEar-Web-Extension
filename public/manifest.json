{
  "manifest_version": 3,
  "name": "DogEar • Notes on the web",
  "short_name": "DogEar",
  "version": "1.0.2",
  "description": "Save thoughts against the exact passages and pages that inspired them. Private, local, and yours.",
  "minimum_chrome_version": "105",
  "action": {
    "default_popup": "index.html",
    "default_title": "Capture a thought with DogEar",
    "default_icon": {
      "16": "icons/dogear-16.png",
      "32": "icons/dogear-32.png"
    }
  },
  "icons": {
    "16": "icons/dogear-16.png",
    "32": "icons/dogear-32.png",
    "48": "icons/dogear-48.png",
    "128": "icons/dogear-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "open-dogear": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open the DogEar library"
    },
    "capture-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture the selected passage in DogEar"
    }
  }
}
